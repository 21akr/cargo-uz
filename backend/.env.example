# ── HTTP ──
PORT=3000
# Comma-separated origins allowed to call the API (your Vercel Mini App URL)
CORS_ORIGINS=http://localhost:5178,https://cargo-uz.vercel.app

# ── Database (Neon / Supabase / local Postgres) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cargo?schema=public

# ── Telegram bot (Mini App auth + push notifications) ──
# From @BotFather. Used to (a) validate Mini App initData, (b) send status messages.
TELEGRAM_BOT_TOKEN=

# Local-only escape hatch: skip initData validation and use this tg id.
# Leave empty in production.
DEV_TG_USER_ID=

# ── MTProto ingest (dedicated Telegram USER account, from my.telegram.org) ──
# If TG_API_ID / TG_API_HASH / TG_SESSION are empty, ingest stays disabled and
# the rest of the app boots normally.
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# Channels to read, as CARRIER=@channel pairs, comma-separated.
# The carrier label is how a post's batch is attributed (the channel identifies the carrier).
INGEST_CHANNELS=WIN=@win_channel,MEEST=@meest_channel,COMFORT=@comfort_channel,TUJJOR=@tujjor_channel,CHIN=@chin_channel

# ── Optional LLM fallback for posts the regex parser can't classify (v2.1) ──
ANTHROPIC_API_KEY=
